{
  "name": "@dg/studio-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/studio-ui.js"
    },
    "./styles.css": "./dist/studio-ui.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && vite build",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "npm run lint:fix && prettier --write .",
    "format:check": "prettier --check . && npm run lint",
    "test:unit": "vitest run --project=unit",
    "test:stories": "vitest run --project=storybook",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/verify.mjs",
    "test:loader": "node scripts/verify-loader.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tailwindcss/vite": "^4.1.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "26.1.0",
    "playwright": "^1.56.0",
    "prettier": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "10.6.7",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
